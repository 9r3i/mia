{
  "version": 2,
  "builds": [
    {
      "src": "vercel.handler.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/vercel.handler.js"
    }
  ],
  "functions": {
    "vercel.handler.js": {
      "includeFiles": "{private/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/vercel.handler.js"
    }
  ]
}